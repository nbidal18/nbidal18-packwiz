{
  "schemaVersion": 1,
  "id": "nbidal18_pack_compat",
  "version": "${version}",
  "name": "nbidal18 Pack Compatibility Enforcer",
  "description": "Rejects clients whose nbidal18 pack identity or managed-content integrity does not match the server.",
  "authors": [
    "nbidal18 contributors"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.nbidal18.packcompat.Nbidal18PackCompat"
    ],
    "client": [
      "dev.nbidal18.packcompat.Nbidal18PackCompatClient"
    ],
    "autohud": [
      "dev.nbidal18.packcompat.autohud.Nbidal18AutoHudApi"
    ]
  },
  "mixins": [
    {
      "config": "nbidal18-pack-compat.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "=${minecraft_version}",
    "bcc": "=${bcc_version}",
    "skin_overrides": "=${skin_overrides_version}"
  },
  "suggests": {
    "autohud": "=${autohud_version}",
    "thermoo": "=${thermoo_version}",
    "immersive_aircraft": "=${immersive_aircraft_version}",
    "immersive_machinery": "=${immersive_machinery_version}",
    "artifacts": "=${artifacts_version}",
    "sodium-extra": "=${sodium_extra_version}"
  }
}
