// ### THE MOD REQUIRES A RESTART OF THE GAME TO APPLY CHANGES ###
{
  // this is the main spread factor (default is 2)
  //
  // tips: a spread factor can be a decimal number (such as 1.5)
  //       a spread factor of 1 means all structure's placements are not modified (useful if you want to use only custom spread factors)
  //       a spread factor above 1 means all structures are rarer
  //       a spread factor below 1 means all structures are more common
  //       a spread factor of 0 disables all structures entirely
  //
  // Raised from 2.75 in v4.4.5. The brief was "oh, a structure finally" rather than
  // "oh, another village", and 2.75 was not getting there. Only newly generated chunks
  // are affected, so this is felt on expeditions rather than around an existing base.
  "spreadFactor": 4.0,

  // Some structure mods/datapacks do not specify a custom salt or use the same salt for all their structures, which might cause structure overlap.
  // Enabling this is supposed to reduce this phenomenon, as all structure sets will have their own salt, hashed from their id.
  // If unsure, leave this enabled.
  "idBasedSalt": true,

  // this is a list of custom spread factors
  //
  // These are ABSOLUTE factors, not multipliers on spreadFactor above, so every one of them
  // has to be restated whenever the global changes.
  //
  // The rule behind the numbers: what you walk past should be rare, what you go looking for
  // should not. Spreading a stronghold or a fortress does not make finding one exciting, it
  // makes progression tedious - and spreading dungeons does not make caves special, it makes
  // them empty. So the global pass is aimed at surface scenery, and everything that gates
  // progression or lives underground is pulled back below it.
  "customSpreadFactors": [
    // --- Surface scenery: the actual "oh, another one" ---------------------------------
    // Structory's small ruins are the densest surface sets in the pack (spacing 23-30).
    {
      "structure": "structory:ruin_quiet",
      "factor": 5.5
    },
    {
      "structure": "structory:ruin",
      "factor": 5.5
    },
    {
      "structure": "structory:mid_rare_ruin",
      "factor": 5.5
    },

    // --- Settlements: a village should be an event -------------------------------------
    {
      "structure": "minecraft:villages",
      "factor": 5.0
    },
    {
      "structure": "towns_and_towers:towns",
      "factor": 5.0
    },
    {
      "structure": "towns_and_towers:other",
      "factor": 5.0
    },
    // Open water gives exceptionally long sightlines, so the small-ocean settlements need
    // more breathing room than land ones even after the global pass rose.
    {
      "structure": "joshie:village_ocean",
      "factor": 5.0
    },
    {
      "structure": "tide:fishing_boat",
      "factor": 3.5
    },

    // --- Already landmarks: do not stack the new global on top -------------------------
    // Mansion sat at twice the old global. Twice the new one would put it far enough out
    // that nobody would ever meet one by accident, which is a different feeling entirely.
    {
      "structure": "minecraft:mansion",
      "factor": 6.0
    },
    {
      "structure": "structory_towers:ultra_rare_towers",
      "factor": 2.0
    },
    {
      "structure": "frostiful:frostologer_castle",
      "factor": 2.0
    },
    {
      "structure": "betteroceanmonuments:ocean_monument",
      "factor": 3.5
    },

    // --- Progression-critical: left alone ----------------------------------------------
    // A stronghold is the only route to the End. Spreading it is not atmosphere, it is a
    // tax on finishing the game.
    {
      "structure": "minecraft:strongholds",
      "factor": 1.0
    },
    {
      "structure": "betterstrongholds:stronghold",
      "factor": 1.0
    },

    // --- The Nether is eight times smaller in overworld terms --------------------------
    // Fortresses gate blaze rods, so they stay findable.
    {
      "structure": "minecraft:nether_complexes",
      "factor": 2.0
    },
    {
      "structure": "betterfortresses:fortress",
      "factor": 2.0
    },
    {
      "structure": "incendium:lesser_structures",
      "factor": 2.0
    },
    {
      "structure": "incendium:greater_structures",
      "factor": 2.0
    },
    {
      "structure": "structory_towers:nether_towers",
      "factor": 2.0
    },
    {
      "structure": "scorchful:piglin_complexes",
      "factor": 2.0
    },

    // --- The End is already a long trip ------------------------------------------------
    {
      "structure": "minecraft:end_cities",
      "factor": 2.0
    },
    {
      "structure": "nullscape:rift",
      "factor": 2.0
    },
    {
      "structure": "nullscape:dragon_skeleton",
      "factor": 2.0
    },
    {
      "structure": "structory_towers:end_towers",
      "factor": 2.0
    },

    // --- Underground: rarer here means emptier caves, not better ones ------------------
    {
      "structure": "bettermineshafts:mineshafts",
      "factor": 2.0
    },
    {
      "structure": "terralith:underground",
      "factor": 2.0
    },
    {
      "structure": "terralith:underground_dungeon",
      "factor": 2.0
    },
    {
      "structure": "betterdungeons:small_dungeons",
      "factor": 2.0
    },
    {
      "structure": "betterdungeons:small_nether_dungeons",
      "factor": 2.0
    },
    {
      "structure": "betterdungeons:spider_dungeons",
      "factor": 2.0
    },
    {
      "structure": "betterdungeons:skeleton_dungeons",
      "factor": 2.0
    },
    {
      "structure": "betterdungeons:zombie_dungeons",
      "factor": 2.0
    },
    {
      "structure": "betterarcheology:underwater_ruins",
      "factor": 2.0
    },
    {
      "structure": "betterarcheology:fossil_sites",
      "factor": 2.0
    },
    {
      "structure": "betterarcheology:archeology_sites",
      "factor": 2.0
    },

    // add the structures you want to modify in the format:
    // (don't forget to remove "//", and use dots for decimal numbers)
    //
    // {
    //     "structure": "namespace:structure_name",
    //     "factor": number
    // },
    //
    // where "structure" is a structure_set or the name of a structure
    // /!\ if you put the name of a structure, all structures in its set will be modified
    // (example: "minecraft:village_plains" will modify all structures in the "villages" set)
    // see https://minecraft.wiki/w/Tutorials/Custom_structures#Structure_Set for more info
    //
    // tip: you can dump all structure sets in a file by running the custom command /dumpstructuresets
    // tip: the same spread factors rules apply here (set to 0 to disable said structure)
  ]
}
