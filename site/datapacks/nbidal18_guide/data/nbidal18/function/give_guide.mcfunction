# Given once per player through the hidden first_join advancement.
give @s minecraft:written_book[minecraft:written_book_content={title:"A Traveler's Notes",author:"nbidal18",generation:0,pages:['{"text":"A Different World\\n\\n","bold":true,"color":"dark_green","extra":[{"text":"Minecraft is familiar,\\nbut its rhythm has\\nchanged.\\n\\nTake the first day\\nslowly. Let the world\\nshow what matters.","bold":false,"color":"black"}]}','{"text":"First Steps\\n\\n","bold":true,"color":"dark_aqua","extra":[{"text":"Wood, stone, food\\nand shelter still\\nmake a good\\nbeginning.\\n\\nWatch the weather.\\nKeep something back\\nbefore wandering far.","bold":false,"color":"black"}]}','{"text":"Working Wood\\n\\n","bold":true,"color":"gold","extra":[{"text":"A tree may need more\\nthan one cut before\\nthe whole trunk gives\\nway.\\n\\nUse an axe and give\\nit a moment.","bold":false,"color":"black"}]}','{"text":"Wounds\\n\\n","bold":true,"color":"dark_red","extra":[{"text":"Hunger will not\\nrestore lost health.\\n\\nBandages are an early\\nlifeline. Look up the\\nrecipe before danger\\nfinds you, and carry\\na spare.","bold":false,"color":"black"}]}','{"text":"Finding Recipes\\n\\n","bold":true,"color":"dark_blue","extra":[{"text":"The panel beside\\nyour inventory is a\\nfield guide.\\n\\nPress O to reveal or\\nhide it. Search there\\nwhen an item or\\nstrange block leaves\\nyou wondering.","bold":false,"color":"black"}]}','{"text":"Heat and Cold\\n\\n","bold":true,"color":"gold","extra":[{"text":"The world notices\\ntemperature.\\n\\nWater and shade cool.\\nSunlight, campfires\\nand Sun Lichen\\noffer warmth.\\n\\nOther answers exist.","bold":false,"color":"black"}]}','{"text":"Living Seasons\\n\\n","bold":true,"color":"dark_green","extra":[{"text":"Weather and seasons\\nreshape familiar\\nplaces.\\n\\nFood, travel and\\ncomfort carry more\\nweight here. Adapt\\nas the world changes.","bold":false,"color":"black"}]}','{"text":"A Longer Day\\n\\n","bold":true,"color":"dark_aqua","extra":[{"text":"Daylight lingers.\\nUse that quiet time\\nto explore, build\\nand prepare.\\n\\nNight is only one\\nkind of darkness.","bold":false,"color":"black"}]}','{"text":"Where Danger Waits\\n\\n","bold":true,"color":"dark_purple","extra":[{"text":"Natural monsters\\ngather mainly in the\\ndeep places below.\\n\\nThe surface is calmer,\\nbut not harmless.\\nSpawners and strange\\nevents ignore that\\npeace.","bold":false,"color":"black"}]}','{"text":"Before You Descend\\n\\n","bold":true,"color":"dark_red","extra":[{"text":"Caves change the mood\\nquickly.\\n\\nBring healing, light,\\nprotection and a way\\nback. A hurried haul\\nis rarely worth being\\nstranded.","bold":false,"color":"black"}]}','{"text":"Beyond Home\\n\\n","bold":true,"color":"dark_green","extra":[{"text":"The terrain is wilder\\nand old places wait\\nfar beyond home.\\n\\nTravel slowly. A way\\nback matters as much\\nas the road ahead.","bold":false,"color":"black"}]}','{"text":"Shared Discoveries\\n\\n","bold":true,"color":"dark_blue","extra":[{"text":"On shared journeys,\\nmany found chests\\nremember each\\nexplorer.\\n\\nThere is no need to\\nrace for every chest.","bold":false,"color":"black"}]}','{"text":"Villages and Trade\\n\\n","bold":true,"color":"gold","extra":[{"text":"Villagers value coins\\ninstead of emeralds.\\n\\nSettlements can grow\\ninto markets. Trade,\\nsave or build a shop\\nwhen the time feels\\nright.","bold":false,"color":"black"}]}','{"text":"Your Journey\\n\\n","bold":true,"color":"dark_aqua","extra":[{"text":"This book is a\\ncompass, not a\\nchecklist.\\n\\nUse the recipe panel\\nwhen needed, then let\\nthe rest reveal itself\\nat its own pace.","bold":false,"color":"black"}]}']}]
